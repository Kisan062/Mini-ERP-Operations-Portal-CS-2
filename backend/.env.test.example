# Test Environment Variables - Copy to .env.test

PORT=5001
NODE_ENV=test

# Use a SEPARATE test database to avoid corrupting development data
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/mini_erp_test_db?schema=public"

JWT_SECRET=test_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=1h

CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=4
